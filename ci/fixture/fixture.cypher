CREATE (:`DatabaseObject`:`GO_BiologicalProcess`:`GO_Term` {`accession`: "0006810", `databaseName`: "GO", `dbId`: 785, `definition`: "The directed movement of substances (such as macromolecules, small molecules, ions) or cellular components (such as complexes and organelles) into, out of or within a cell, or between cells, or within a multicellular organism by means of some agent such as a transporter or a transporter complex, a pore or a motor protein.", `displayName`: "transport", `name`: "transport", `schemaClass`: "GO_BiologicalProcess", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0006810"});
CREATE (:`Compartment`:`DatabaseObject`:`GO_CellularComponent`:`GO_Term` {`accession`: "0005886", `databaseName`: "GO", `dbId`: 876, `definition`: "The membrane surrounding a cell that separates the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.", `displayName`: "plasma membrane", `name`: "plasma membrane", `schemaClass`: "Compartment", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0005886"});
CREATE (:`Compartment`:`DatabaseObject`:`GO_CellularComponent`:`GO_Term` {`accession`: "0005576", `databaseName`: "GO", `dbId`: 984, `definition`: "The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.", `displayName`: "extracellular region", `name`: "extracellular region", `schemaClass`: "Compartment", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0005576"});
CREATE (:`DatabaseObject`:`GO_MolecularFunction`:`GO_Term` {`accession`: "0004175", `databaseName`: "GO", `dbId`: 1793, `definition`: "Catalysis of the hydrolysis of internal, alpha-peptide bonds in a polypeptide chain.", `displayName`: "endopeptidase activity", `name`: "endopeptidase activity", `schemaClass`: "GO_MolecularFunction", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0004175"});
CREATE (:`DatabaseObject`:`GO_MolecularFunction`:`GO_Term` {`accession`: "0008237", `databaseName`: "GO", `dbId`: 1795, `definition`: "Catalysis of the hydrolysis of peptide bonds by a mechanism in which water acts as a nucleophile, one or two metal ions hold the water molecule in place, and charged amino acid side chains are ligands for the metal ions.", `displayName`: "metallopeptidase activity", `name`: "metallopeptidase activity", `schemaClass`: "GO_MolecularFunction", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0008237"});
CREATE (:`DatabaseObject`:`GO_MolecularFunction`:`GO_Term` {`accession`: "0004190", `databaseName`: "GO", `dbId`: 1933, `definition`: "Catalysis of the hydrolysis of internal, alpha-peptide bonds in a polypeptide chain by a mechanism in which a water molecule bound by the side chains of aspartic residues at the active center acts as a nucleophile.", `displayName`: "aspartic-type endopeptidase activity", `ecNumber`: "3.4.23.1", `name`: "aspartic-type endopeptidase activity", `schemaClass`: "GO_MolecularFunction", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0004190"});
CREATE (:`DatabaseObject`:`GO_BiologicalProcess`:`GO_Term` {`accession`: "0007049", `databaseName`: "GO", `dbId`: 4757, `definition`: "The progression of biochemical and morphological phases and events that occur in a cell during successive cell replication or nuclear replication events. Canonically, the cell cycle comprises the replication and segregation of genetic material followed by the division of the cell, but in endocycles or syncytial cells nuclear replication or nuclear division may not be followed by cell division.", `displayName`: "cell cycle", `name`: "cell cycle", `schemaClass`: "GO_BiologicalProcess", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0007049"});
CREATE (:`DatabaseObject`:`GO_BiologicalProcess`:`GO_Term` {`accession`: "0000278", `databaseName`: "GO", `dbId`: 4802, `definition`: "Progression through the phases of the mitotic cell cycle, the most common eukaryotic cell cycle, which canonically comprises four successive phases called G1, S, G2, and M and includes replication of the genome and the subsequent segregation of chromosomes into daughter cells. In some variant cell cycles nuclear replication or nuclear division may not be followed by cell division, or G1 and G2 phases may be absent.", `displayName`: "mitotic cell cycle", `name`: "mitotic cell cycle", `schemaClass`: "GO_BiologicalProcess", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0000278"});
CREATE (:`Compartment`:`DatabaseObject`:`GO_CellularComponent`:`GO_Term` {`accession`: "0005654", `databaseName`: "GO", `dbId`: 7660, `definition`: "That part of the nuclear content other than the chromosomes or the nucleolus.", `displayName`: "nucleoplasm", `name`: "nucleoplasm", `schemaClass`: "Compartment", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0005654"});
CREATE (:`DatabaseObject`:`GO_BiologicalProcess`:`GO_Term` {`accession`: "0006261", `databaseName`: "GO", `dbId`: 7961, `definition`: "A DNA replication process that uses parental DNA as a template for the DNA-dependent DNA polymerases that synthesize the new strands.", `displayName`: "DNA-templated DNA replication", `name`: "DNA-templated DNA replication", `schemaClass`: "GO_BiologicalProcess", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0006261"});
CREATE (:`DatabaseObject`:`GO_BiologicalProcess`:`GO_Term` {`accession`: "0006260", `databaseName`: "GO", `dbId`: 7962, `definition`: "The cellular metabolic process in which a cell duplicates one or more molecules of DNA. DNA replication begins when specific sequences, known as origins of replication, are recognized and bound by the origin recognition complex, and ends when the original DNA molecule has been completely duplicated and the copies topologically separated. The unit of replication usually corresponds to the genome of the cell, an organelle, or a virus. The template for replication can either be an existing DNA molecule or RNA.", `displayName`: "DNA replication", `name`: "DNA replication", `schemaClass`: "GO_BiologicalProcess", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0006260"});
CREATE (:`DatabaseObject`:`GO_BiologicalProcess`:`GO_Term` {`accession`: "0019221", `databaseName`: "GO", `dbId`: 8651, `definition`: "The series of molecular signals initiated by the binding of a cytokine to a receptor on the surface of a cell, and ending with the regulation of a downstream cellular process, e.g. transcription.", `displayName`: "cytokine-mediated signaling pathway", `name`: "cytokine-mediated signaling pathway", `schemaClass`: "GO_BiologicalProcess", `url`: "https://www.ebi.ac.uk/QuickGO/term/GO:0019221"});
